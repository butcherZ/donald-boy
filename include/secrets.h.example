#pragma once

// Copy this file to secrets.h and fill in your own values.
// secrets.h is git-ignored so your credentials don't end up on GitHub.

#define WIFI_SSID  "your-wifi-name"
#define WIFI_PASS  "your-wifi-password"

// URL of the donald-boy server.
// Use your laptop's LAN IP (NOT 127.0.0.1 — that means "this device"
// from the StickS3's perspective, which is the stick itself).
// Find your laptop's IP: `hostname -I` on Linux, `ipconfig` on Windows.
#define SERVER_URL "http://192.168.1.X:8000/donaldify"
