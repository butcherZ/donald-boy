# Donald Boy server config.
# Copy to `.env` and fill in your values. `.env` is git-ignored.
# Anything set in your shell with `export FOO=...` overrides what's here.

# ----- Secrets / accounts -----

ANTHROPIC_API_KEY=sk-ant-replace-me
# HF_TOKEN=hf_replace_me            # optional — only needed for faster HF downloads

# ----- Voice cloning reference -----

# Path is relative to the server/ directory.
REF_AUDIO=trump_8s.wav

# Optional: exact transcript of the reference audio. Leave commented out
# to let OmniVoice auto-Whisper it (almost always good enough).
# REF_TEXT=

# ----- Output cap & loudness shaping (the dials worth tuning) -----

CLAUDE_MODEL=claude-haiku-4-5-20251001
MAX_OUT_SECONDS=15

# Loudness pipeline (server/main.py: _to_pcm16le).
# Signal flow:  TTS audio  →  compressor  →  peak-normalize  →  saturator  →  VOLUME  →  int16 LE
#
# COMPRESSOR_EXP   < 1.0 lifts quiet samples; closer to 0 = more squashing. 1.0 disables.
# TARGET_PEAK      Where the compressed signal's loudest sample lands before saturation. 0.99 = nearly full-scale.
# SATURATOR_GAIN   Drives the tanh soft-clipper. Higher = louder + warmer + more harmonic distortion.
# VOLUME           Final output scale, 0.0–1.0. Use this to TURN THE TOY DOWN without rebuilding the pipeline.
#                  1.0  = max loudness given saturator settings (default — same as before this knob existed)
#                  0.5  = ~6 dB quieter (half amplitude — half as loud)
#                  0.25 = ~12 dB quieter (quarter amplitude — quiet desk volume)
#                  0.0  = silence
#                  Halving VOLUME each step is a perceptually even loudness step.
TARGET_PEAK=0.99
SATURATOR_GAIN=2.5
COMPRESSOR_EXP=0.6
VOLUME=1.0
